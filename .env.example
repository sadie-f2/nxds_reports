# Nexudus API base URL (e.g. https://spaces.nexudus.com/api)
NEXUDUS_BASE_URL=https://spaces.nexudus.com/api

# Authentication type: "basic" or "bearer"
NEXUDUS_AUTH_TYPE=basic

# Basic auth credentials (used when NEXUDUS_AUTH_TYPE=basic)
NEXUDUS_EMAIL=you@example.com
NEXUDUS_PASSWORD=yourpassword

# Bearer token (used when NEXUDUS_AUTH_TYPE=bearer)
NEXUDUS_TOKEN=

# Set to 1 to use local mock data instead of live API (no credentials needed)
NEXUDUS_MOCK=0

# Eventbrite API
EVENTBRITE_TOKEN=your_private_token_here
EVENTBRITE_ORG_ID=your_organisation_id_here
EVENTBRITE_MOCK=0
